{
  "info": {
    "name": "Ecommerce Inventory System API",
    "description": "Comprehensive API testing collection for the Vertex Inventory Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "ecommerce-inventory-api-v1"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminUsername",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminRole",
      "value": "admin",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Unified Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has success field', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('success');",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('Response contains user data', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('user');",
                  "    pm.expect(jsonData.user).to.have.property('username');",
                  "    pm.expect(jsonData.user).to.have.property('role');",
                  "});",
                  "",
                  "// Save auth data for subsequent requests",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.user) {",
                  "        pm.collectionVariables.set('adminUsername', jsonData.user.username);",
                  "        pm.collectionVariables.set('adminRole', jsonData.user.role);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\",\n  \"rememberDevice\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/unified-login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "unified-login"]
            },
            "description": "Test unified login endpoint with admin credentials"
          },
          "response": []
        },
        {
          "name": "Validate Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Session is valid', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('valid');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/validate-session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "validate-session"]
            },
            "description": "Validate current session"
          },
          "response": []
        }
      ],
      "description": "Authentication endpoints testing"
    },
    {
      "name": "Search API",
      "item": [
        {
          "name": "Search - No Auth Headers (Public Access)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has results array', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('results');",
                  "    pm.expect(jsonData.results).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Only product results returned (no auth)', function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.results.length > 0) {",
                  "        jsonData.results.forEach(function(result) {",
                  "            pm.expect(result.type).to.equal('product');",
                  "        });",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/search?q=product",
              "host": ["{{baseUrl}}"],
              "path": ["api", "search"],
              "query": [
                {
                  "key": "q",
                  "value": "product"
                }
              ]
            },
            "description": "Test search endpoint without authentication headers - should only return products"
          },
          "response": []
        },
        {
          "name": "Search - With Admin Auth Headers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has results array', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('results');",
                  "    pm.expect(jsonData.results).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Response includes query field', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('query');",
                  "});",
                  "",
                  "pm.test('Admin can see all result types', function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.results.length > 0) {",
                  "        var types = jsonData.results.map(r => r.type);",
                  "        console.log('Result types:', types);",
                  "        // Admin should potentially see products, orders, contacts, chat",
                  "        pm.expect(types).to.include.members(['product']);",
                  "    }",
                  "});",
                  "",
                  "pm.test('Each result has required fields', function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.results.length > 0) {",
                  "        jsonData.results.forEach(function(result) {",
                  "            pm.expect(result).to.have.property('id');",
                  "            pm.expect(result).to.have.property('type');",
                  "            pm.expect(result).to.have.property('title');",
                  "            pm.expect(result).to.have.property('link');",
                  "        });",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-username",
                "value": "{{adminUsername}}",
                "type": "text"
              },
              {
                "key": "x-user-role",
                "value": "{{adminRole}}",
                "type": "text"
              },
              {
                "key": "x-user-display-name",
                "value": "Admin User",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/search?q=test",
              "host": ["{{baseUrl}}"],
              "path": ["api", "search"],
              "query": [
                {
                  "key": "q",
                  "value": "test"
                }
              ]
            },
            "description": "Test search endpoint WITH admin authentication headers - should return all result types"
          },
          "response": []
        },
        {
          "name": "Search - Short Query",
          "event": [
