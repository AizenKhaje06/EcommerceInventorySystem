        {
          "name": "Search - With Regular User Headers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has results', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('results');",
                  "});",
                  "",
                  "pm.test('Regular user cannot see orders', function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.results.length > 0) {",
                  "        var orderResults = jsonData.results.filter(r => r.type === 'order');",
                  "        pm.expect(orderResults).to.have.lengthOf(0);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-username",
                "value": "regular_user",
                "type": "text"
              },
              {
                "key": "x-user-role",
                "value": "agent",
                "type": "text"
              },
              {
                "key": "x-user-display-name",
                "value": "Regular User",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/search?q=order",
              "host": ["{{baseUrl}}"],
              "path": ["api", "search"],
              "query": [
                {
                  "key": "q",
                  "value": "order"
                }
              ]
            },
            "description": "Test that non-admin users cannot search orders"
          },
          "response": []
        }
      ],
      "description": "Comprehensive testing of the search API with different authentication scenarios"
    },
