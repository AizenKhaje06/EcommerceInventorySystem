          "host": ["{{baseUrl}}"],
          "path": ["api", "chat", "conversations"]
        },
        "description": "Validation Test: Group name exceeding 100 characters should fail (MAX_GROUP_NAME_LENGTH from chat-utils.ts)"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400', () => pm.response.to.have.status(400));",
              "pm.test('Error code is VALIDATION_ERROR', () => {",
              "    pm.expect(pm.response.json().code).to.equal('VALIDATION_ERROR');",
              "});",
              "pm.test('Error mentions length or max characters', () => {",
              "    const error = pm.response.json().error.toLowerCase();",
              "    pm.expect(error).to.match(/too long|max|100/);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
